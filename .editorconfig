# Ширина строки должна совпадать с formatter.page_width в analysis_options.yaml.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.dart]
indent_size = 2
max_line_length = 120

[*.{yaml,yml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
